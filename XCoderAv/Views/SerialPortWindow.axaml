<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:XCoderAv.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="XCoderAv.Views.SerialPortWindow"
        x:DataType="vm:SerialPortViewModel"
        Title="串口调试工具" Width="900" Height="650"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox.ConfigTextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>
        <Style Selector="Button.ActionButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="Border.GroupBorder">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Styles>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 配置面板 -->
        <Border Grid.Row="0" Classes="GroupBorder">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="串口" VerticalAlignment="Center" Margin="4,2"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PortNames}" SelectedItem="{Binding PortName}" Margin="2" Height="28"/>
                <Button Grid.Row="0" Grid.Column="1" Content="刷新" Command="{Binding RefreshPortsCommand}" Classes="ActionButton" Width="50" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="波特率" VerticalAlignment="Center" Margin="4,2"/>
                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" Margin="2" Height="28"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="校验位" VerticalAlignment="Center" Margin="4,2"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedIndex="{Binding ParityIndex}" Margin="2" Height="28"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="数据位" VerticalAlignment="Center" Margin="4,2"/>
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}" Margin="2" Height="28"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="停止位" VerticalAlignment="Center" Margin="4,2"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedIndex="{Binding StopBitsIndex}" Margin="2" Height="28"/>
                <Button Grid.Row="2" Grid.Column="1" Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectCommand}" Classes="ActionButton" Width="80" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="发送/接收" VerticalAlignment="Center" Margin="4,2"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="已发:" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BytesSent}" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="已收:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding BytesReceived}" Margin="4,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志 -->
        <TextBox Grid.Row="1" Text="{Binding Log}" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="12" Margin="0,4"
                 BorderThickness="1" BorderBrush="#D0D0D0"/>

        <!-- 发送区 -->
        <Border Grid.Row="2" Classes="GroupBorder">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SendText}" Classes="ConfigTextBox" Margin="2"/>
                <CheckBox Grid.Row="0" Grid.Column="1" Content="HEX发送" IsChecked="{Binding HexSend}" Margin="4,2" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="0" Grid.Column="1" Content="HEX显示" IsChecked="{Binding HexDisplay}" Margin="4,2" VerticalAlignment="Center" IsVisible="False"/>
                <Button Grid.Row="0" Grid.Column="2" Content="发送" Command="{Binding SendCommand}" Classes="ActionButton" Width="80" Height="30"/>
                <Button Grid.Row="0" Grid.Column="2" Content="清空" Command="{Binding ClearLogCommand}" Classes="ActionButton" Width="60" Height="30" HorizontalAlignment="Right" Margin="0,0,90,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
