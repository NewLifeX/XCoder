<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:XCoderAv.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
        x:Class="XCoderAv.Views.DataSyncWindow"
        x:DataType="vm:DataSyncViewModel"
        Title="数据同步" Width="1000" Height="750"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBox.ConfigTextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>
        <Style Selector="Button.ActionButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style Selector="Border.GroupBorder">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Styles>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接配置 -->
        <Border Grid.Row="0" Classes="GroupBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="源数据库" VerticalAlignment="Center" Margin="4,2"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SourceConn}" Margin="2" Height="28"/>
                <Button Grid.Column="1" Content="{Binding IsSourceConnected, StringFormat='{}{0}'}" Command="{Binding ConnectSourceCommand}" Classes="ActionButton" Width="80" HorizontalAlignment="Right"/>

                <TextBlock Grid.Column="2" Text="目标数据库" VerticalAlignment="Center" Margin="8,2,4,2"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding TargetConnections}" SelectedItem="{Binding TargetConn}" Margin="2" Height="28"/>
                <Button Grid.Column="4" Content="连接目标" Command="{Binding ConnectTargetCommand}" Classes="ActionButton" Width="80"/>
            </Grid>
        </Border>

        <!-- 表列表 -->
        <Grid Grid.Row="1" Margin="0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="数据表" FontWeight="Bold" Margin="4,2" VerticalAlignment="Center"/>
                <Button Content="全选" Command="{Binding SelectAllCommand}" Classes="ActionButton"/>
                <Button Content="反选" Command="{Binding InvertSelectionCommand}" Classes="ActionButton"/>
                <Button Content="仅源表" Command="{Binding SelectDifferentCommand}" Classes="ActionButton"/>
                <Button Content="开始同步" Command="{Binding SyncDataCommand}" Classes="ActionButton" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Tables}" Margin="0,4"
                     BorderThickness="1" BorderBrush="#D0D0D0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding EnableSync}" Margin="4,2"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,2"/>
                            <TextBlock Grid.Column="2" Text="{Binding SourceCount}" Margin="4,2"/>
                            <TextBlock Grid.Column="3" Text="{Binding TargetCount}" Margin="4,2"/>
                            <TextBlock Grid.Column="4" Text="{Binding SyncCount}" Margin="4,2"/>
                            <TextBlock Grid.Column="5" Text="{Binding Description}" Margin="4,2"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 状态 -->
        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="4,2">
            <TextBlock Text="{Binding Status}"/>
        </Border>
    </Grid>
</Window>
