<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        x:CompileBindings="False"
        x:Class="XCoderMac.MacShellWindow"
        Title="XCoder · 新生命码神工具"
        Width="1320" Height="850" MinWidth="1000" MinHeight="690"
        WindowStartupLocation="CenterScreen"
        Icon="avares://XCoderMac/Docs/Assets/XCoderMac-1024.png"
        Background="#F7F9FC">
    <Window.Styles>
        <Style Selector="Button.sidebar-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="46"/>
        </Style>
        <Style Selector="Button.sidebar-item.selected">
            <Setter Property="Background" Value="#DEE8FA"/>
        </Style>
        <Style Selector="Button.sidebar-item.selected:pointerover">
            <Setter Property="Background" Value="#D7E5FA"/>
        </Style>
        <Style Selector="Button.sidebar-item:pointerover">
            <Setter Property="Background" Value="#E6ECF5"/>
        </Style>
        <!-- 左侧已打开工具的选中底色统一由外层 Border 控制。
             内层激活按钮禁止 Fluent 默认 Hover 叠加另一条色块。 -->
        <Style Selector="Button.sidebar-tool-tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.sidebar-tool-tab:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.sidebar-tool-tab:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.sidebar-tool-tab:focus">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Fluent 默认 Button 模板的 PART_ContentPresenter 可能在 hover 时变成 Black。
             这里强制其保持透明，由外层条目 Border 唯一绘制选中态。 -->
        <Style Selector="Button.sidebar-tool-tab /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.sidebar-tool-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sidebar-tool-tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tool-card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5EAF3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
        </Style>
        <Style Selector="Button.tool-card:pointerover">
            <Setter Property="Background" Value="#F4F8FF"/>
            <Setter Property="BorderBrush" Value="#ADC6F4"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="216,*">
        <!-- macOS 工具侧边栏 -->
        <Border Grid.Column="0" Background="#F0F3F8" BorderBrush="#E3E8F0" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,25,10,18">
                <StackPanel Grid.Row="0" Margin="2,0,0,31" Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#2463C5" CornerRadius="12">
                            <TextBlock Text="X" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="XCoder" FontSize="16" FontWeight="SemiBold" Foreground="#172942"/>
                            <TextBlock Text="NEWLIFE.XCODER · DEVELOPER TOOLS" FontSize="8" FontWeight="SemiBold" Foreground="#74839A"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Grid 约束菜单项占满导航栏内部宽度，不再显示内容宽度的胶囊按钮。 -->
                <!-- 工作台：工具首页 + 真实打开的窗口。侧栏条目和顶部标签复用同一份 OpenTabs。 -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="工作台" FontSize="11" FontWeight="SemiBold"
                               Foreground="#94A0B0" Margin="13,0,0,10"/>
                    <Button x:Name="AllToolsNavButton" Classes="sidebar-item selected"
                            Click="AllTools_Click" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="26,*">
                            <TextBlock Text="▦" FontSize="20" Foreground="#3368BD" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="所有工具" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#233F69" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="SidebarOpenTabsSection" Margin="2,10,0,0"
                                Spacing="5" IsVisible="False">
                        <TextBlock x:Name="SidebarOpenTabsTitle" Text="已打开工具 (0)"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#899AB0" Margin="11,0,0,5"/>
                        <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SidebarOpenTabs" ItemsSource="{Binding OpenTabs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TabBackground}"
                                                CornerRadius="9" Margin="0,0,5,5"
                                                Height="38" BorderBrush="#DCE6F3" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,30">
                                                <Button Grid.Column="0" Classes="sidebar-tool-tab"
                                                        Tag="{Binding}" Click="SidebarTab_Click"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="8,0,0,0"
                                                        Cursor="Hand">
                                                    <Grid ColumnDefinitions="22,*">
                                                        <TextBlock Text="{Binding Icon}" FontSize="12"
                                                                   Foreground="{Binding TabForeground}"
                                                                   VerticalAlignment="Center" TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                   Foreground="{Binding TabForeground}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Tag="{Binding}" Content="×"
                                                        Click="SidebarCloseTab_Click"
                                                        Foreground="#6782A0" Background="Transparent"
                                                        BorderThickness="0" Padding="0" Width="25" Height="25"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        ToolTip.Tip="关闭窗口"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="0,25,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                    <TextBlock Text="工具分类" FontSize="11" FontWeight="SemiBold" Foreground="#94A0B0" Margin="13,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="sidebar-item" Click="Category_Click" Tag="{Binding}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,5">
                                    <Grid ColumnDefinitions="26,*">
                                        <TextBlock Text="{Binding Icon}" FontSize="18" Foreground="#627995" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="#435771" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3" CornerRadius="14" Background="#E5EAF3" Padding="15,13">
                    <StackPanel Spacing="6">
                        <TextBlock Text="XCoder · 预览版" FontSize="12" FontWeight="SemiBold" Foreground="#2B466D"/>
                        <TextBlock Text="基于 Avalonia 与 NewLife" FontSize="11" Foreground="#66788E"/>
                        <TextBlock Text="工具持续适配中" FontSize="11" Foreground="#8A99A9"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 工作区 -->
        <Grid Grid.Column="1" RowDefinitions="82,*,32">
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E7ECF3" BorderThickness="0,0,0,1" Padding="31,0">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="开发者工具中心" FontSize="17" FontWeight="SemiBold" Foreground="#263A54"/>
                        <TextBlock Text="专注开发、连接与调试" FontSize="11" Foreground="#8A96A8"/>
                    </StackPanel>
                    <!-- 顶部已打开的标签按钮与左侧已打开工具、顶部标签栏重复，因此移除。 -->
                    <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                             Width="307" Height="41" Padding="13,9"
                             Watermark="⌕   搜索工具名称、协议或用途..."
                             FontSize="13" Background="#F6F8FB" BorderBrush="#E5EAF2"
                             CornerRadius="11" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="31,29,26,24" Spacing="24">
                    <Border x:Name="HomeHeroSection" CornerRadius="20"
                            Background="#1D3B6B" Padding="28,25" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,Auto" MinHeight="147">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="YOUR PRODUCTIVITY WORKSPACE" Foreground="#9EBEEA" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"/>
                                <TextBlock Text="让每一个开发任务更简单" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Text="基于 NewLife 生态，汇聚数据库、通信协议与日常开发工具。" Foreground="#C2D3EA" FontSize="13"/>
                                <Button Content="开始数据建模  ↗" Click="StartModeling_Click"
                                        Background="#FFFFFF" Foreground="#234773" CornerRadius="9"
                                        FontSize="12" FontWeight="SemiBold" Padding="17,9"
                                        HorizontalAlignment="Left" Margin="0,9,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="115" Height="115" CornerRadius="58" Background="#31548A"
                                    Margin="15,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="X" Foreground="#CFE2FF" FontSize="79" FontWeight="Light"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="HomeStatsSection" ColumnDefinitions="*,*,*">
                        <Border Grid.Column="0" Margin="0,0,13,0" Background="White" BorderBrush="#E8EDF4" BorderThickness="1" CornerRadius="14" Padding="18,15">
                            <StackPanel Spacing="4">
                                <TextBlock Text="26" FontSize="24" FontWeight="SemiBold" Foreground="#254B84"/>
                                <TextBlock Text="工具入口" FontSize="12" Foreground="#8391A5"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="0,0,13,0" Background="White" BorderBrush="#E8EDF4" BorderThickness="1" CornerRadius="14" Padding="18,15">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CategoryCount}" FontSize="24"
                                           FontWeight="SemiBold" Foreground="#254B84"/>
                                <TextBlock Text="工具分类" FontSize="12" Foreground="#8391A5"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="#E8EDF4" BorderThickness="1" CornerRadius="14" Padding="18,15">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Avalonia" FontSize="23" FontWeight="SemiBold" Foreground="#254B84"/>
                                <TextBlock Text="NewLife 生态集成" FontSize="12" Foreground="#8391A5"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 用户可自定义“快捷入口”，放在探索全部工具上方。 -->
                    <StackPanel x:Name="QuickToolsSection" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,0">
                            <StackPanel Spacing="5">
                                <TextBlock Text="快捷入口" FontSize="21" FontWeight="SemiBold"
                                           Foreground="#1D304B"/>
                                <TextBlock Text="常用工具一键直达 · 支持自定义、排序"
                                           FontSize="12" Foreground="#8A98AA"/>
                            </StackPanel>
                            <Button x:Name="ManageQuickEntriesButton" Grid.Column="1"
                                    Classes="secondary" Content="⚙  管理快捷入口"
                                    Click="ManageQuickEntries_Click"
                                    CornerRadius="9" Padding="15,9"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="QuickToolCards" ItemsSource="{Binding QuickTools}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <primitives:UniformGrid Columns="{Binding ToolColumns}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="tool-card" Click="ToolCard_Click" Tag="{Binding}"
                                            Margin="0,0,13,13" Padding="15,13" Height="112"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="37,*">
                                            <Border Width="33" Height="33" Background="#EAF1FE"
                                                    CornerRadius="9" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" Foreground="#3469B7"
                                                           FontSize="16" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="#273B58"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                       Text="{Binding Description}" FontSize="11"
                                                       Foreground="#8294A8" TextTrimming="CharacterEllipsis"
                                                       Margin="1,9,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="QuickEntryEmptyMessage"
                                   Text="还没有快捷入口，点击右上角「管理快捷入口」添加常用工具。"
                                   IsVisible="False" FontSize="13" Foreground="#8196AC"
                                   Margin="6,5,0,13"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" Margin="2,5,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SectionTitle" Text="探索全部工具" FontSize="23" FontWeight="SemiBold" Foreground="#1D304B"/>
                            <TextBlock x:Name="SectionDescription" Text="选择一个工具开始工作，已有功能直接复用原项目。"
                                       FontSize="12" Foreground="#8A98AA"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#E1E8F2" BorderThickness="1" Background="White"
                                CornerRadius="20" Padding="14,7" VerticalAlignment="Center">
                            <TextBlock x:Name="ToolCount" Text="26 个工具" FontSize="12" Foreground="#59739A"/>
                        </Border>
                    </Grid>

                    <!-- 均分可用宽度，列数随工具区实际宽度变化；消除右侧剩余大块空白。 -->
                    <ItemsControl x:Name="ToolCards" ItemsSource="{Binding VisibleTools}"
                                  HorizontalAlignment="Stretch" SizeChanged="ToolCards_SizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Columns="{Binding ToolColumns}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="tool-card" Tag="{Binding}" Click="ToolCard_Click"
                                        MinWidth="0" Height="154" Margin="0,0,13,13" Padding="18"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,11">
                                            <Border Width="39" Height="39" Background="#EAF1FE" CornerRadius="11">
                                                <TextBlock Text="{Binding Icon}" FontSize="19" FontWeight="Bold"
                                                           Foreground="#3469B7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="↗" FontSize="17" Foreground="#A0AEC1"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Margin="0,0,0,9" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#273B58"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="#8B98A9" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyMessage" Text="没有找到匹配的工具，请尝试其他关键词。"
                               IsVisible="False" FontSize="14" Foreground="#8796A7" Margin="5,10,0,20"/>

                    <Border BorderBrush="#E6ECF4" BorderThickness="0,1,0,0" Padding="2,16,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="XCoder · Powered by NewLife" FontSize="11" Foreground="#A6B0BE"/>
                            <TextBlock Grid.Column="1" Text="⌘ F 搜索工具" FontSize="11" Foreground="#A6B0BE"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧工具区域为单主窗口标签页。主页布局完全保留。 -->
            <Grid x:Name="TabbedWorkspace" Grid.Row="1" IsVisible="False" RowDefinitions="58,*"
                  Background="#F7F9FC">
                <Border Grid.Row="0" Background="White" BorderBrush="#E3E9F2"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="30,*,30,Auto" Margin="12,0,16,0">
                        <Button Grid.Column="0" Content="‹" Click="ScrollTabsLeft_Click"
                                Width="26" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#58708E" FontSize="23"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="向左浏览标签"/>
                        <ScrollViewer x:Name="TabsScrollViewer" Grid.Column="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <ItemsControl ItemsSource="{Binding OpenTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TabBackground}" CornerRadius="9"
                                                BorderBrush="#DDE7F4" BorderThickness="1"
                                                Width="174" Height="38" Margin="0,0,1,0">
                                            <Grid ColumnDefinitions="*,30">
                                                <Border Grid.Column="0" Tag="{Binding}"
                                                        PointerPressed="TabHeader_PointerPressed"
                                                        Background="Transparent"
                                                        CornerRadius="8" Padding="11,0,0,0"
                                                        Cursor="Hand" ToolTip.Tip="{Binding Title}">
                                                    <Grid ColumnDefinitions="19,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                   Foreground="{Binding TabForeground}"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   TextAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                   Margin="7,0,0,0"
                                                                   Foreground="{Binding TabForeground}"
                                                                   FontWeight="SemiBold" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                                <Button Grid.Column="1" Content="×" Click="CloseTab_Click"
                                                        Tag="{Binding}" Background="Transparent"
                                                        BorderThickness="0" CornerRadius="7"
                                                        Width="25" Height="25" Padding="0"
                                                        Foreground="#72849A" FontSize="17"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        ToolTip.Tip="关闭此标签 (⌘W)"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="2" Content="›" Click="ScrollTabsRight_Click"
                                Width="26" Height="30" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#58708E" FontSize="23"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="向右浏览标签"/>
                        <Button Grid.Column="3" Content="⌂  工具首页" Click="AllTools_Click"
                                Background="#EEF3FA" Foreground="#496683"
                                CornerRadius="9" Padding="14,8"
                                Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#F7F9FC" ClipToBounds="True">
                    <ContentControl x:Name="ToolTabContent"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>
                </Border>
            </Grid>

            <!-- 所有工具共用状态栏；当前工具的 Status/StatusText 自动投射到这里。 -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E9F2"
                    BorderThickness="0,1,0,0" Padding="18,0,20,0">
                <Grid ColumnDefinitions="Auto,12,*">
                    <TextBlock x:Name="WorkspaceStatusTitle" Text="工作台"
                               FontSize="11" FontWeight="SemiBold" Foreground="#59718E"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="WorkspaceStatusText"
                               Text="就绪 · 请选择一个工具" FontSize="11"
                               Foreground="#59718E" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right" HorizontalAlignment="Right"
                               ToolTip.Tip="{Binding #WorkspaceStatusText.Text}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
